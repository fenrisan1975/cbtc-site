# Copy this file to .env for local development (netlify dev will also read it).
# In production, set these under Netlify: Site settings > Environment variables.

# Netlify DB: no connection string needed here. The @netlify/database
# package (see src/lib/db.js) connects automatically based on environment.
# Just make sure you've run `netlify link` and use `netlify dev` locally.

# Mailchimp -- Account > Extras > API keys to create a key. The prefix
# (e.g. "us21") is the part after the dash at the end of the key.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Admin area (/admin) -- a single shared password, no accounts. Pick
# something long and random; set the same value in Netlify env vars.
# Kids (James, Amelia) use this same password to log in -- see SETUP.md.
ADMIN_PASSWORD=

# Resend (https://resend.com) -- sends the "new business submitted" email.
# Free tier is plenty at this scale. RESEND_FROM_EMAIL must be on a domain
# you've verified in the Resend dashboard (constancebaytrading.com, once its
# DNS records are added -- see SETUP.md). NOTIFY_EMAILS is a comma-separated
# list of who gets the notification.
RESEND_API_KEY=
RESEND_FROM_EMAIL=notify@constancebaytrading.com
NOTIFY_EMAILS=james@constancebaytrading.com,amelia@constancebaytrading.com,andrew@constancebaytrading.com
