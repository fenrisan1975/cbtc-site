# Copy this file to .env for local development (netlify dev will also read it).
# In production, set these under Netlify: Site settings > Environment variables.

# Netlify DB sets this automatically once you enable it for the site --
# you shouldn't need to set it by hand except for local dev, where
# `netlify dev` will pull it down for you if you're linked to the site.
NETLIFY_DATABASE_URL=

# Mailchimp -- Account > Extras > API keys to create a key. The prefix
# (e.g. "us21") is the part after the dash at the end of the key.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
